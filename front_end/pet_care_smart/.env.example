# ============================================================
# PetCare Frontend - Environment Variables
# Copy this file to .env.local and fill in actual values
# ============================================================

# API Base URL
VITE_API_BASE_URL=http://localhost:8888/api/v1

# Google OAuth Configuration
# Get Client ID from: https://console.cloud.google.com/apis/credentials
# IMPORTANT: This is the PUBLIC client ID (safe to expose in frontend)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Redirect URI (must match Google Console configuration)
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
