# Database
DB_URL=jdbc:mysql://localhost:3306/pet_care_identity?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=root

# JWT (generate a strong random key, min 64 chars)
JWT_SIGNER_KEY=e95719c52849d612d61dc20c0e14b25ece0a7a22d8eacb434e93d0f7257f2071
JWT_VALID_DURATION=3600
