# ============================================================
# PetCareSmart — Environment Variables Template
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env vào repository!
# ============================================================

# --- Database ---
DB_ROOT_PASSWORD=your_strong_root_password
DB_USERNAME=root
DB_PASSWORD=your_strong_app_password

# --- JWT (tối thiểu 64 ký tự, dùng chung cho tất cả service) ---
# Tạo key mới bằng: openssl rand -base64 64
JWT_SIGNER_KEY=your_jwt_signer_key_min_64_chars_long

# --- Admin account (tạo lần đầu khởi động) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password

# --- Cloudinary (user_service + product_service) ---
# Đăng ký tại: https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- VNPay (payment_service) ---
# Liên hệ VNPay để nhận credentials
VNPAY_TMN_CODE=your_tmn_code
VNPAY_SECRET_KEY=your_secret_key

# --- CORS ---
# Production: chỉ định domain cụ thể, không dùng *
CORS_ALLOWED_ORIGINS=http://localhost:5173
