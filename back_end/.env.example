# ============================================================
# PetCare Microservices - Environment Variables Template
# Copy this file to .env and fill in actual values
# ============================================================

# ─── INFRASTRUCTURE ───────────────────────────────────────
# MySQL Database Configuration
DB_ROOT_PASSWORD=root_password_change_me
DB_USERNAME=petcare_user
DB_PASSWORD=petcare_password_change_me

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─── SECURITY ─────────────────────────────────────────────
# JWT Configuration (IMPORTANT: Change these in production!)
JWT_SIGNER_KEY=your-secret-key-must-be-at-least-512-bits-long-for-hs512-algorithm-use-this-or-generate-your-own-secure-key

# Google OAuth2 Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS Configuration (Comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ─── ADMIN CREDENTIALS ─────────────────────────────────────
# Default Admin User (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── SERVICE URLS ─────────────────────────────────────────
# Eureka Service Discovery
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka-server:8761/eureka/

# Internal Service URLs (Docker network)
IDENTITY_SERVICE_URL=http://identity-service:8080
USER_SERVICE_URL=http://user-service:8082
PRODUCT_SERVICE_URL=http://product-service:8081
ORDER_SERVICE_URL=http://order-service:8083
PAYMENT_SERVICE_URL=http://payment-service:8084
CART_SERVICE_URL=http://cart-service:8085

# Gateway Configuration
GATEWAY_PORT=8888

# ─── LOGGING ───────────────────────────────────────────────
# Log Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# ─── OPTIONAL: EXTERNAL SERVICES ──────────────────────────
# Payment Gateway (if using external payment processor)
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_key
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret

# Cloud Storage (if using Cloudinary or similar)
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Hugging Face token for image_ai_service model downloads (optional)
# Create at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_optional
IMAGE_ANALYSIS_INCLUDE_BUILT_INS=false

# Gemini API for chat_service
# GEMINI_MODEL can be changed to another free-tier model your API project has access to.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ─── ENVIRONMENT ──────────────────────────────────────────
# Environment: development, staging, production
ENVIRONMENT=development

# ─── NOTES ────────────────────────────────────────────────
# 1. DO NOT commit .env file to version control
# 2. Keep .env.example in version control for reference
# 3. Update values for each environment
# 4. Use strong, unique passwords in production
# 5. Rotate JWT_SIGNER_KEY periodically

