# Database
DB_URL=jdbc:mysql://localhost:3306/pet_care_user?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_db_password

# JWT (phải khớp với identity_service)
JWT_SIGNER_KEY=your_very_strong_secret_key_at_least_64_characters_long_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
